// Read the token at an index, and test the current token's text.
kind_at(int i) {
  int result = (import tok_kind)[i];
} return int result;

text_at(int i) {
  string res = (import tok_text)[i];
} return string res;

cur_is(string s) {
  int p = pos();
  string t = text_at(p);
  int result = t == s;
} return int result;
