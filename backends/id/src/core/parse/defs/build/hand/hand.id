// One token position: if it starts a `Name : Kind` definition, register it; if
// it starts a `bg:`/`fg:` colour property, record it on the current definition.
handle_def(int i) {
  if(is_def_start(i)) {
    handle_def_tail(i);
  }
} return void;

is_def_start(int i) {
  int r = 0;
  if(kind_at(i) == 1 && text_at(i + 1) == ":") {
    r = kind_at(i + 2) == 1;
  }
} return int r;

handle_prop(int i) {
  int r = 0;
  if(is_prop(i, "bg")) {
    string text2 = text_at(i + 2);
    int color = parse_color(text2);
    set_last_bg(color);
  } else {
    other_prop(i);
  }
} return void;
