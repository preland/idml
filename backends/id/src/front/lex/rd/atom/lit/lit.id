// Quoted strings ("...") and class-strings (`...`) store their inner text with
// the delimiters stripped; every other single char is a punctuation token.
read_str(int i) {
  int j = i + 1;
  while(j < len((import src)) && charat((import src), j) != 34) {
    j = j + 1;
  }
  int result = read_str_tail(i, j);
} return int result;

read_btick(int i) {
  int j = i + 1;
  while(j < len((import src)) && charat((import src), j) != 96) {
    j = j + 1;
  }
  int result = read_btick_tail(i, j);
} return int result;

read_punct(int i) {
  int c = charat((import src), i);
  int result = read_punct_tail(i, c);
} return int result;
