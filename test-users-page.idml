# ============================================================================
# Recreation of jsbio's app/admin/users/page.tsx, authored declaratively in the
# .idml DSL at the test route ./test/users.
#
# Written in the tightened DSL: comments only in this header; every element has
# explicit percentage dimensions that tile its container to 100% (no vacant
# space); all styling lives in named variants; no `auto`. At most 3 children per
# container and ≤4 nesting depth, so wide/deep UI is factored into defines: the
# create + edit dialogs share one UserModal wrapping a shared UserFields. Both
# modals write one page-level form record (~email / ~name / ~role), toggled by
# @state.createOpen / @state.editOpen. Modals + the feedback Overlay are
# out-of-flow, so they do not take part in tiling.
# ============================================================================

AppShell:Row `bg-gray-50` { minHeight: 100vh }
SideNav:Col `bg-gray-900 text-white` { padding: 1rem gap: 0.5 }
NavGroup:Col { gap: 0.5 }
MainPane:Col { padding: 1.5rem }
BrandText:Text `font-bold` { marginBottom: 1rem }
NavButton:Button `rounded hover:bg-gray-800` { align: left padding: 0.5rem }

PageCol:Col { maxWidth: 72rem marginLeft: auto marginRight: auto gap: 1.5 }
HeaderRow:Row
PageTitle:Text `font-bold text-gray-900`
SignOutBtn:Button `text-gray-600 hover:text-gray-900`
ActionRow:Row
PrimaryBtn:Button `bg-blue-600 text-white rounded hover:bg-blue-700`
{ padding: 0.5rem }

TableCard:Table `bg-white rounded-lg shadow`
{ overflowX: hidden overflowY: hidden }
CellName:Text `font-medium text-gray-900`
CellEmail:Text `text-gray-600`
RoleBadge:Text `font-semibold rounded-full border`
{ display: inline-flex padding: 0.25rem }
EditBtn:Button `text-blue-600 hover:text-blue-900`

ModalPanel:Modal `bg-white rounded-lg` { padding: 1.5rem maxWidth: 28rem }
ModalTitle:Text `font-bold text-gray-900` { marginBottom: 1rem }
UserField:Col { marginBottom: 1rem }
FieldLabel:Label `font-medium text-gray-700`
{ display: block marginBottom: 0.25rem }
FieldInput:Input `border border-gray-300 rounded-md` { padding: 0.5rem }
FieldSelect:Select `border border-gray-300 rounded-md` { padding: 0.5rem }
ModalBtnRow:Row { gap: 0.75 marginTop: 0.5rem }
SubmitBtn:Button `bg-blue-600 text-white rounded` { padding: 0.5rem }
CancelBtn:Button `border border-gray-300 rounded` { padding: 0.5rem }
FeedbackBtn:Button `bg-blue-600 text-white rounded-full shadow-lg`
{ padding: 0.5rem }

define DefaultPageFormat() {
  AppShell()[100,100,top-left] {
    SideNav()[100,15,top-left] {
      BrandText("JSBIO")[8,100,top-left]{}
      NavGroup()[16,100,top-left,fit-h] {
        NavButton("Logout", logout)[50,100,top-left]{}
        NavButton("Feedback", openFeedback)[50,100,top-left]{}
      }
      Spacer()[76,100,top-left,hug]{}
    }
    MainPane()[100,85,top-left] {
      Children()[100,100,top-left]{}
    }
  }
}

define UserFields() {
  UserField()[33,100,top-left] {
    FieldLabel("Email")[30,100,top-left]{}
    FieldInput(~email)[70,100,top-left]{}
  }
  UserField()[33,100,top-left] {
    FieldLabel("Name")[30,100,top-left]{}
    FieldInput(~name)[70,100,top-left]{}
  }
  UserField()[34,100,top-left] {
    FieldLabel("Role")[30,100,top-left]{}
    FieldSelect(~role)[70,100,top-left] {
      Option("Commenter")[100,100,top-left]{}
      Option("Researcher")[100,100,top-left]{}
      Option("SeniorResearcher")[100,100,top-left]{}
      Option("Approver")[100,100,top-left]{}
      Option("Admin")[100,100,top-left]{}
      Option("Disabled")[100,100,top-left]{}
    }
  }
}

define UserModal(open, title, btnLabel, btnAction, cancelAction) {
  ModalPanel(open)[80,40,center] {
    ModalTitle(title)[15,100,top-left]{}
    UserFields()[65,100,top-left]{}
    ModalBtnRow()[20,100,top-left,fit-w] {
      SubmitBtn(btnLabel, btnAction)[100,50,top-left]{}
      CancelBtn("Cancel", cancelAction)[100,50,top-left]{}
    }
  }
}

./test/users
DefaultPageFormat()[100,100,top-left] {
  PageCol()[100,100,top-left] {
    HeaderRow()[10,100,top-left] {
      PageTitle("User Management")[100,70,top-left]{}
      SignOutBtn("Sign Out", logout)[100,30,top-right]{}
    }
    ActionRow()[10,100,top-right] {
      PrimaryBtn("Create User", openCreate)[100,100,top-right]{}
    }
    TableCard(@users)[80,100,top-left,hug] {
      Column("Name")[10,30,top-left]{
        CellName(@item.name)[100,100,top-left]{}
      }
      Column("Email")[10,30,top-left]{
        CellEmail(@item.email)[100,100,top-left]{}
      }
      Column("Role")[10,20,top-left]{
        RoleBadge(@item.role)[100,100,top-left]{}
      }
      Column("Actions")[10,20,top-right]{
        EditBtn("Edit", editUser)[100,100,top-right]{}
      }
    }
  }

  UserModal(@state.createOpen, "Create New User", "Create User",
    createUser, closeCreate)[100,100,top-left]{}
  UserModal(@state.editOpen, "Edit User", "Update User",
    updateUser, closeEdit)[100,100,top-left]{}

  Overlay()[100,100,top-left] {
    FeedbackBtn("Feedback", openFeedback)[10,10,bottom-right]{}
  }
}
